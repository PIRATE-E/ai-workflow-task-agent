{
  // =========================================================================
  // BASEDPYRIGHT & PYRIGHT CONFIGURATION FOR LAZYVIM (NEOVIM)
  //
  // PURPOSE:
  // Maximizes LSP responsiveness, reduces memory usage from 4GB+ to ~300MB,
  // and eliminates typing lag when navigating the cold-wind-ai workspace.
  // =========================================================================

  // 1. NAMESPACE RESOLUTION (WHY & HOW):
  // WHY: PEP 420 native namespace packaging splits the `coldwind.*` namespace
  //      across multiple workspace packages (`coldwind-core` and `coldwind-desktop`).
  // HOW: Adding both "core/src" and "desktop/src" to extraPaths allows Basedpyright
  //      to resolve `from coldwind.core...` and `from coldwind.desktop...`
  //      imports seamlessly without requiring global editable installation in sys.path.
  "extraPaths": [
    "core/src",
    "desktop/src"
  ],

  // 2. VIRTUAL ENVIRONMENT LOCATION (WHY & HOW):
  // WHY: Ensures Basedpyright resolves type annotations from the uv workspace venv
  //      rather than the host system's global Python environment.
  // HOW: Points to the local project-root ".venv" directory managed by uv.
  "venvPath": ".",
  "venv": ".venv",

  // 3. TARGET SOURCE ROOTS (WHY & HOW):
  // WHY: Prevents the LSP from scanning arbitrary non-Python directories in the root.
  // HOW: Restricts active symbol scanning strictly to active source trees and tests.
  "include": [
    "core/src",
    "desktop/src",
    "tests"
  ],

  // 4. EXCLUSIONS & DISK WATCHER THROTTLING (WHY & HOW):
  // WHY: The legacy RAG directory (core/src/coldwind/core/RAG) contains unrefactored
  //      files with heavy optional imports; reports/ contains 100+ markdown files;
  //      and .venv contains over 100,000 third-party library files.
  // HOW: Explicitly tells Basedpyright's file-watcher to ignore these trees entirely,
  //      drastically reducing filesystem event CPU usage and initial indexing load.
  "exclude": [
    "**/core/src/coldwind/core/RAG",
    "**/basic_logs",
    "**/reports",
    "**/.venv",
    "**/__pycache__"
  ],

  // 5. DIAGNOSTIC SUPPRESSION FOR UNREFACTORED MODULES (WHY & HOW):
  // WHY: RAG is deferred to a dedicated refactoring phase; legacy files should not
  //      flood the LazyVim quickfix/trouble list with type errors.
  // HOW: Suppresses diagnostics for all files under core/src/coldwind/core/RAG.
  "ignore": [
    "core/src/coldwind/core/RAG"
  ],

  // 6. OPEN-FILES-ONLY DIAGNOSTIC MODE (CRITICAL PERFORMANCE FIX) (WHY & HOW):
  // WHY: The default "workspace" mode forces Basedpyright to analyze and type-check
  //      every single file across the entire repository in the background, consuming
  //      multiple gigabytes of RAM and freezing the Neovim editor.
  // HOW: "openFilesOnly" instructs the LSP to only run deep type evaluation on the
  //      files currently open in your active LazyVim buffers.
  "diagnosticMode": "openFilesOnly",

  // 7. DISABLE THIRD-PARTY LIBRARY INDEXING (CRITICAL PERFORMANCE FIX) (WHY & HOW):
  // WHY: Basedpyright attempts to build a persistent symbol index across every
  //      installed third-party package in .venv (like browser-use, protobuf, and pydantic).
  // HOW: Setting "indexing": false stops this heavy background worker thread completely.
  //      You still get full autocomplete and hover definitions for whatever you import,
  //      but the editor stops wasting CPU and memory crawling unused library internals.
  "indexing": false,

  // 8. MISSING IMPORTS POLICY (WHY & HOW):
  // WHY: During rapid local development and phase-by-phase migration, optional packages
  //      (like Neo4j or optional MCP tools) may be selectively deferred.
  // HOW: Downgrades missing imports from blocking red errors to subtle warnings.
  "reportMissingImports": "warning"
}
